{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=merfit;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "merfit-api",
    "Audience": "merfit-app",
    "SigningKey": "REPLACE_WITH_A_SECRET_AT_LEAST_32_BYTES_LONG_VIA_USER_SECRETS_OR_ENV",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "EmailVerificationTokenHours": 24,
    "PasswordResetTokenHours": 1,
    "MaxActiveRefreshTokensPerUser": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RevenueCat": {
    "WebhookAuthorizationHeader": "REPLACE_WITH_REVENUECAT_WEBHOOK_SECRET",
    "Environment": "Production"
  },
  "Expo": {
    "PushApiUrl": "https://exp.host/--/api/v2/push/send",
    "AccessToken": ""
  },
  "Email": {
    "Provider": "Logging",
    "FromAddress": "no-reply@merfit.app",
    "FromName": "Merfit"
  },
  "Storage": {
    "Provider": "Local",
    "LocalBasePath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": ""
  }
}
