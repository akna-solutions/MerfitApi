{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=merfit;Username=postgres;Password=12345678"
  },
  "MerfitScoring": {
    "_comment": "MB FIT puan kurallari. MerfitCustomerApi appsettings'teki ayni bolumle ayni tutulmalidir; admin puan/siralama yeniden hesaplamalari bu degerleri kullanir.",
    "WorkoutCompletedPoints": 100,
    "MaxScoredWorkoutsPerDay": 2,
    "PersonalRecordPoints": 25,
    "MealLogDayPoints": 10,
    "WaterLogDayPoints": 5,
    "TimeZoneOffsetHours": 3
  },
  "Notifications": {
    "_comment": "Admin tarafi bildirim isleri. Push gonderimi MerfitCustomerApi'nin Notifications bolumuyle yapilir; DefaultTimeZone iki API'de ayni olmalidir.",
    "WorkerEnabled": true,
    "WorkerInterval": "00:00:30",
    "DefaultTimeZone": "Europe/Istanbul",
    "LargeAudienceThreshold": 1000,
    "MaterializeBatchSize": 1000,
    "JobLockDuration": "00:10:00",
    "MaxJobAttempts": 5,
    "JobRetryBaseDelay": "00:01:00",
    "MaxSelectedUsers": 5000
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG",
    "Issuer": "MerfitApi",
    "Audience": "MerfitApp",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  }
}